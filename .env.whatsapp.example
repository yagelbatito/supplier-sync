# =====================================================
# WhatsApp Cloud API (Meta)
# =====================================================
# System User access token (long-lived) מ-Meta Developer Dashboard
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# Phone Number ID של מספר ה-WhatsApp Business שלך
WHATSAPP_PHONE_NUMBER_ID=1234567890

# מחרוזת רנדומלית שאתה ממציא (אימות handshake של webhook)
WHATSAPP_VERIFY_TOKEN=my_super_secret_verify_token_change_me

# App Secret מ-Meta App Dashboard (לאימות חתימת X-Hub-Signature-256)
# אופציונלי אבל מומלץ מאוד בפרודקשן
WHATSAPP_APP_SECRET=

# מספרים מורשים (international format ללא +, מופרד בפסיקים)
# רק הודעות מהמספרים האלה יעובדו - אחרות מתעלמים בשקט
WHATSAPP_ALLOWED_NUMBERS=972501234567,972527654321

# גרסת API של Meta (default v21.0)
WHATSAPP_API_VERSION=v21.0

# פורט שעליו שרת ה-webhook יקשיב
WHATSAPP_WEBHOOK_PORT=8000

# Host (0.0.0.0 ל-ngrok/production, 127.0.0.1 לפיתוח בלבד)
WHATSAPP_WEBHOOK_HOST=0.0.0.0

# =====================================================
# OCR
# =====================================================
# משתמש באותו OPENAI_API_KEY שכבר קיים ב-.env שלך
# OPENAI_API_KEY=sk-...  ← כבר קיים

# מודל ה-vision לחילוץ שדות מהתמונה
WHATSAPP_OCR_MODEL=gpt-4o

# =====================================================
# Pending store
# =====================================================
# איפה לשמור מוצרים שעברו OCR ומחכים למחיר (יחסי לתיקיית הפרויקט)
WHATSAPP_PENDING_FILE=data/pending_whatsapp.json

# כמה זמן (שעות) לשמור מוצר ב-pending לפני שמוחקים אוטומטית
WHATSAPP_PENDING_TTL_HOURS=72
